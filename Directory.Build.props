<Project>
  <!-- Keep generated files out of src and make the developer-facing paths short. -->
  <PropertyGroup>
    <BaseOutputPath>$(MSBuildThisFileDirectory)build\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)build\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath Condition="'$(MSBuildProjectName)' == 'TableCleaner.Core'">$(MSBuildThisFileDirectory)build\bin\TableCleaner.Core\</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(MSBuildProjectName)' == 'TableCleaner.Core'">$(MSBuildThisFileDirectory)build\obj\TableCleaner.Core\</BaseIntermediateOutputPath>
    <BaseOutputPath Condition="'$(MSBuildProjectName)' == 'TableCleaner.Core.Tests'">$(MSBuildThisFileDirectory)build\bin\TableCleaner.Core.Tests\</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(MSBuildProjectName)' == 'TableCleaner.Core.Tests'">$(MSBuildThisFileDirectory)build\obj\TableCleaner.Core.Tests\</BaseIntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- Single source of truth for the public release. Update this value
         before creating a GitHub tag/release. -->
    <Version>1.1.3</Version>
    <AssemblyVersion>1.1.3.0</AssemblyVersion>
    <FileVersion>1.1.3.0</FileVersion>
    <InformationalVersion>1.1.3</InformationalVersion>
  </PropertyGroup>
</Project>
