<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>笨蛋表格</AssemblyName>
    <RootNamespace>TableCleaner</RootNamespace>
    <Product>笨蛋表格</Product>
    <Description>Windows 桌面小工具，用于对表格数据做快速清洗</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationHighResolutionSupport>true</ApplicationHighResolutionSupport>
    <ApplicationDefaultFont>Microsoft YaHei, 9pt</ApplicationDefaultFont>
    <ApplicationIcon>Resources\app-icon.ico</ApplicationIcon>
    <DesktopUpdateKitRoot>$(MSBuildThisFileDirectory)..\..\shared\DesktopUpdateKit</DesktopUpdateKitRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TableCleaner.Core\TableCleaner.Core.csproj" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.7.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\app-icon-16.png" />
    <EmbeddedResource Include="$(UpdaterStubPath)"
                      LogicalName="DesktopUpdateKit.Resources.UpdaterStub.exe"
                      Condition="'$(UpdaterStubPath)' != '' and Exists('$(UpdaterStubPath)')" />
    <Compile Include="$(DesktopUpdateKitRoot)\src\DesktopUpdateKit\*.cs"
             Link="Services\DesktopUpdateKit\%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="EnsureDesktopUpdateKitSubmodule" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(DesktopUpdateKitRoot)\src\DesktopUpdateKit\UpdateClient.cs')"
           Text="DesktopUpdateKit submodule is missing. Run: git submodule update --init --recursive" />
  </Target>

  <!-- Copy config/exports to output -->
  <ItemGroup>
    <None Update="config\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="exports\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
